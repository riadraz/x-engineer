import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { SESClient, SendEmailCommand } from "@aws-sdk/client-ses";

const s3 = new S3Client({ region: "us-east-1" });
const ses = new SESClient({ region: "us-east-1" });

export const handler = async (event) => {
    const record = event.Records?.[0]?.ses;
    if (!record) return;

    const messageId = record.mail.messageId;
    const sender = record.mail.source;
    const recipients = (record.mail.destination || []).join(", ");
    const subject = record.mail.commonHeaders?.subject || "(No Subject)";

    const obj = await s3.send(new GetObjectCommand({
        Bucket: "moses-mails",
        Key: `general-mails/${messageId}`
    }));

    const rawEmail = await obj.Body.transformToString();
    const bodyText = rawEmail.split(/\r?\n\r?\n/).slice(1).join("\n\n").slice(0, 15000);

    await ses.send(new SendEmailCommand({
        Source: `"Inbound Forwarder" <mmcldint@mail.moses20608.click>`,
        Destination: { ToAddresses: ["riadraz@gmail.com"] },
        ReplyToAddresses: [sender],
        Message: {
            Subject: { Data: `[FWD from ${sender}] ${subject}`, Charset: "UTF-8" },
            Body: {
                Text: {
                    Data: `From: ${sender}\nTo: ${recipients}\n\n${bodyText}`,
                    Charset: "UTF-8"
                }
            }
        }
    }));
};